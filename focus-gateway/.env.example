# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
# Public base URL Twilio can reach (your ngrok/cloudflared tunnel in dev)
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app
# Bearer token required on all /admin routes
ADMIN_TOKEN=change-me

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
# Set false only for local testing without signature validation
VALIDATE_TWILIO_SIGNATURES=true

# SQLite database file
DATABASE_PATH=./focus-gateway.db
